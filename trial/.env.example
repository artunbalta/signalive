# Signalive web trial: environment variables.
# Copy to .env.local for development. With nothing set, the app runs on mock
# providers and an in-memory store (development only).
# Every key below is read on the server only. Only NEXT_PUBLIC_* values reach
# the browser, and those are public by design.

# --- Data: Supabase (Postgres + pgvector, Auth, Storage) --------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or the legacy service role key. Server only. Used
# for the audio expiry cron, the research export, and deleting the auth user
# on "delete everything". Without it, deletion still removes every row and
# stored object, but leaves an empty anonymous auth user behind.
SUPABASE_SECRET_KEY=

# --- LLM: Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Lowest thinking setting for voice latency. On claude-sonnet-5-5 the default
# is between_tools; other models default to adaptive. Values: adaptive,
# between_tools, disabled (only models that accept it).
LLM_THINKING=
LLM_EFFORT=low
# Model for notes extraction (not latency bound). Defaults to LLM_MODEL.
LLM_NOTES_MODEL=
# Server side refusal fallback: "default" or "off".
LLM_FALLBACKS=default

# --- Speech to text ----------------------------------------------------------
# Assistant and recorder recognizer: deepgram | openai | groq | mock.
# Unset: the first one with a key, in that order.
STT_PROVIDER=
# Live streaming from the browser (Deepgram only, needs a fixed language).
STT_STREAMING=on
# Two or three recognizers for the lab, comma separated.
LAB_STT_PROVIDERS=deepgram,openai,groq

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Text to speech ----------------------------------------------------------
# elevenlabs | openai | mock. Unset: ElevenLabs if configured, else OpenAI.
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Required for ElevenLabs: premade voices expire on 2026-12-31, so there is
# no built in default. One multilingual voice, or one per language.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_TR=
# OpenAI /v1/audio/speech models shut down on 2027-01-06.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE_EN=marin
OPENAI_TTS_VOICE_TR=marin

# --- Embeddings (semantic note search) ---------------------------------------
# voyage | openai | mock. Unset: Voyage if configured, else OpenAI.
EMBEDDINGS_PROVIDER=
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retention ------------------------------------------------------------------
RAW_AUDIO_RETENTION_DAYS=7
LAB_AUDIO_RETENTION_DAYS=90

# --- Operations --------------------------------------------------------------
# Vercel sends it as a bearer token to /api/cron/expire-audio.
CRON_SECRET=
# Bearer token for /api/admin/lab-results (all participants' lab metrics).
ADMIN_API_TOKEN=
NEXT_PUBLIC_SITE_URL=

# Production refuses mock providers and the memory store unless allowed:
ALLOW_MOCK_PROVIDERS=
ALLOW_MEMORY_STORE=
