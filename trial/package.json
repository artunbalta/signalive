{
  "name": "signalive-trial",
  "version": "0.1.0",
  "private": true,
  "description": "Signalive web trial: earbud assistant, recorder and notes, whisper and noise lab.",
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "test:supabase": "vitest run --config vitest.integration.config.mts",
    "test:audio-fixtures": "node scripts/make-test-audio.mjs",
    "test:video-fixtures": "node scripts/make-test-video.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
